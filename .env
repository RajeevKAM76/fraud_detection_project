# Database Configuration
DATABASE_NAME=fraud_detection
DATABASE_USER=your_username
DATABASE_PASSWORD=your_password
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_URL=postgresql://${DATABASE_USER}:${DATABASE_PASSWORD}@${DATABASE_HOST}:${DATABASE_PORT}/${DATABASE_NAME}

# API Keys
ETHERSCAN_API_KEY=your_etherscan_api_key
BSCSCAN_API_KEY=your_bscscan_api_key

# API Configuration
DEXSCREENER_BASE_URL=https://api.dexscreener.com/tokens/v1

# Analysis Settings
SUSPICIOUS_TRANSACTION_THRESHOLD=10000
PRICE_CHANGE_THRESHOLD=30
MINIMUM_LIQUIDITY=5000
TRANSACTION_ANALYSIS_WINDOW=24

# Application Settings
DEBUG=True
LOG_LEVEL=INFO

# Data Paths
DATA_DIR=./data
RESULTS_DIR=./data/results
LOG_DIR=./logs

# API Request Settings
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# Test Settings
DEFAULT_TOKEN_ADDRESSES=0x123,0x456